{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true,
    "jest": true
  },
  "extends": ["eslint:recommended", "prettier"],
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "script"
  },
  "globals": {
    "supabase": "readonly",
    "Supabase": "readonly",
    "supabaseClient": "writable",
    "services": "writable",
    "monthlyIncomes": "writable",
    "currentMonthIndex": "writable",
    "simulationCart": "writable",
    "simulatedNewItems": "writable",
    "months": "readonly",
    "ExcelJS": "readonly",
    "saveAs": "readonly",
    "Chart": "readonly",
    "loadData": "readonly",
    "saveData": "readonly",
    "renderApp": "readonly",
    "renderTabs": "readonly",
    "editItem": "writable",
    "togglePaid": "writable",
    "deleteItem": "writable",
    "simulateCancellation": "writable",
    "openEmptySimulation": "writable",
    "addServiceToSimulation": "writable",
    "addNewServiceToSimulation": "writable",
    "removeServiceFromSimulation": "writable",
    "removeNewServiceFromSimulation": "writable",
    "updateSimulatedAmount": "writable",
    "renderProjectionChart": "readonly",
    "renderConsumptionChart": "readonly",
    "exportToExcel": "readonly",
    "importFromExcel": "readonly",
    "escapeHTML": "readonly",
    "updateSimulationView": "readonly"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "warn"
  }
}
